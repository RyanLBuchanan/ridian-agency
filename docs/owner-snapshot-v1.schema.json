      "type": "object"
    },
    "Due": {
      "additionalProperties": false,
      "properties": {
        "dueDate": {
          "description": "YYYY-MM-DD as recorded (no timezone), or empty.",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
          "title": "Duedate",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "daysOverdue": {
          "title": "Daysoverdue",
          "type": "integer"
        },
        "missedPeriods": {
          "title": "Missedperiods",
          "type": "integer"
        }
      },
      "required": [
        "dueDate",
        "status",
        "daysOverdue",
        "missedPeriods"
      ],
